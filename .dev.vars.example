# Copy to .dev.vars for local `wrangler dev`. For production, set via:
#   wrangler secret put TELEGRAM_BOT_TOKEN --env production
# or the Cloudflare dashboard. NEVER commit real values.

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Comma-separated Telegram user IDs allowed to use the bot as merchants
ALLOWED_USERS=

# Operator wallet encryption key (any 32+ char random string)
WALLET_ENCRYPTION_KEY=

# AI
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Admin bearer token for /admin/* endpoints
ADMIN_API_KEY=
