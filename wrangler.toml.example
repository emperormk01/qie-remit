# Copy to wrangler.toml and fill in your own resource IDs.
# KV/D1 IDs are account-specific — create your own with `wrangler kv|d1 create`.
# Secrets (TELEGRAM_BOT_TOKEN, AI_API_KEY, WALLET_ENCRYPTION_KEY, etc.) are set
# via `wrangler secret put <NAME>` and are NEVER stored in this file.

name = "qie-remit"
main = "src/index.ts"
compatibility_date = "2024-12-01"
compatibility_flags = ["nodejs_compat"]

# KV namespaces (create with: wrangler kv namespace create <NAME>)
[[kv_namespaces]]
binding = "SESSIONS"
id = "<your-sessions-kv-id>"

[[kv_namespaces]]
binding = "CONFIG"
id = "<your-config-kv-id>"

# D1 database (create with: wrangler d1 create qie-remit-db)
[[d1_databases]]
binding = "DB"
database_name = "qie-remit"
database_id = "<your-d1-database-id>"

# Non-secret vars (safe to commit). Secrets go via `wrangler secret put`.
[vars]
QIE_CHAIN_ID = "1983"
QIE_RPC = "https://rpc1testnet.qie.digital/"
QIE_EXPLORER = "https://testnet.qie.digital"
APP_NAME = "QIE Remit"
AI_PROVIDER = "poolside"
AI_BASE_URL = "https://inference.poolside.ai/v1"
AI_MODEL = "poolside/laguna-m.1"

# Secrets you must set before first deploy:
#   wrangler secret put TELEGRAM_BOT_TOKEN
#   wrangler secret put TELEGRAM_WEBHOOK_SECRET
#   wrangler secret put WALLET_ENCRYPTION_KEY   (32+ random chars)
#   wrangler secret put AI_API_KEY              (Poolside / OpenRouter key)
#   wrangler secret put API_KEY                 (admin bearer, optional)
# Optional: PUBLIC_BASE_URL (custom domain); defaults to the workers.dev URL.

# Cron trigger: auto-detect pending payments every minute
[triggers]
crons = ["* * * * *"]
